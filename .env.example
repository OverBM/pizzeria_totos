# Copia este archivo como `.env` solo si necesitas estas variables en local.
# `.env` está en .gitignore: nunca subas claves de servicio ni secretos.

# Proyecto de Firebase usado por la app y por la semilla.
FIREBASE_PROJECT_ID=pizzeria-totos

# Ruta a la clave de servicio del Admin SDK (solo para `tool/seed_firestore.mjs`).
# Descárgala en Firebase Console → Configuración del proyecto → Cuentas de servicio.
GOOGLE_APPLICATION_CREDENTIALS=tool/seed-service-account.json

# Carpeta pública de Drive con los medios del catálogo.
DRIVE_FOLDER_URL=

# Opcional: mapa de assets locales a IDs de Drive. Por defecto:
# tool/drive_media.json (ver tool/drive_media.example.json).
DRIVE_MEDIA_FILE=tool/drive_media.json

# Emulador de Firestore (desarrollo local sin credenciales reales).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
